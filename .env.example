# Docker/local MySQL root password
MYSQL_ROOT_PASSWORD=change-this-to-a-long-random-password

# Prisma (used by Vercel serverless API routes)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://root:hello123@localhost:3306/employee_management

# Legacy direct DB variables used by server.js local runtime
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=hello123
DB_NAME=employee_management
